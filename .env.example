# ─────────────────────────────────────────────────────────────────────────────
# Swift / CrossRemit — environment variables template
#
# Copy this file to .env (repo root) for docker-compose local testing.
# The same vars go into .env.local on the EC2 instance for CodeDeploy.
# NEVER commit .env or .env.local — they contain real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Groq (AI forex predictor) ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Serper (forex news search) ────────────────────────────────────────────────
SERPER_API_KEY=...

# ── Razorpay ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
